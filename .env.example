# ===== PostgreSQL =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=3dprint
POSTGRES_HOST=db            # localhost — без Docker
POSTGRES_PORT=5432

# ===== MinIO / S3 =====
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000          # http://localhost:9000 — без Docker
MINIO_PUBLIC_ENDPOINT=http://localhost:9000   # адрес для presigned-ссылок (виден браузеру)
MINIO_BUCKET_NAME=3dprint-models

# ===== Django =====
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
PAY_STUB_ENABLED=True       # False — автопереход в PAID после одобрения менеджером

# ===== Redis / RQ =====
REDIS_HOST=redis            # localhost — без Docker
REDIS_PORT=6379

# ===== Mailpit =====
EMAIL_HOST=mailpit          # localhost — без Docker
EMAIL_PORT=1025

# ===== Frontend =====
VITE_PROXY_TARGET=http://backend:8000     # http://localhost:8000 — без Docker
VITE_API_URL=/api

# ===== Облегчённый запуск без Docker (необязательно) =====
# USE_SQLITE=True           # SQLite вместо PostgreSQL
# USE_LOCAL_STORAGE=True    # файлы моделей в backend/media_private вместо MinIO
# TASKS_SYNC=True           # выполнять задачи сразу, без Redis/воркера
